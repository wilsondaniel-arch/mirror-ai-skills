# Mirror AI — copy to `.env` in the project root (never commit `.env`).
# The server and CLI load this file automatically when you use Node 20.12+.
# You can also export variables in your shell instead.

# -----------------------------------------------------------------------------
# Required only when using the API audit runner (no Claude Code CLI)
# -----------------------------------------------------------------------------
# API key from https://console.anthropic.com/ — use a real API key, not a
# Claude Code OAuth token (ANTHROPIC_AUTH_TOKEN is not supported for audits).
# ANTHROPIC_API_KEY=sk-ant-api03-...

# Optional override for Anthropic-compatible endpoints (testing only).
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# -----------------------------------------------------------------------------
# Optional — audit runner and tuning
# -----------------------------------------------------------------------------
# Force runner: cursor (Cursor Agent CLI) | cli (Claude Code) | api (Messages API).
# Default in Cursor: cursor when `agent` is installed; else cli, api key, or cursor.
# MIRROR_AI_RUNNER=cursor

# Cursor Agent CLI model (Opus 5.5 by default in Cursor sessions).
# MIRROR_AI_CURSOR_MODEL=claude-opus-5-5

# Thinking effort for audits: low | medium | high | xhigh | max
# MIRROR_AI_EFFORT=high

# Model ids (optional). When unset, audits started from a Cursor Agent terminal
# use Claude Opus 5.5; other terminals use claude-opus-5 / opus.
# MIRROR_AI_API_MODEL=claude-opus-5-5
# MIRROR_AI_CLI_MODEL=claude-opus-5-5

# Parallel audit sections (default 3)
# MIRROR_AI_CONCURRENCY=3

# Per-section timeout in milliseconds (default 2700000 = 45 minutes)
# MIRROR_AI_TIMEOUT_MS=2700000

# API runner only: max characters of source per platform per module (default 200000)
# MIRROR_AI_EVIDENCE_BUDGET=200000

# Directory for saved audit reports (default: ./generated reports/)
# MIRROR_AI_REPORTS_DIR=

# Debug: log arguments passed to the claude CLI (path to a writable file)
# MIRROR_AI_CLI_LOG=

# -----------------------------------------------------------------------------
# Optional — web server
# -----------------------------------------------------------------------------
# PORT=4173

# -----------------------------------------------------------------------------
# Optional — private Bitbucket clones (when git credential helper is unavailable)
# -----------------------------------------------------------------------------
# App password or repository access token — see Bitbucket → Personal settings →
# App passwords / Access tokens. Used only for bitbucket.org URLs.
# BITBUCKET_USERNAME=
# BITBUCKET_TOKEN=
# Legacy name (same as BITBUCKET_TOKEN for HTTPS git):
# BITBUCKET_APP_PASSWORD=

# -----------------------------------------------------------------------------
# Optional — Compose screenshot rendering (Android)
# -----------------------------------------------------------------------------
# ANDROID_HOME=/path/to/Android/sdk
# MIRROR_AI_ANDROID_VARIANT=JmDevDebug
# MIRROR_AI_MAX_SCREENS=6
# COMPOSE_SCREENSHOT_VERSION=0.0.1-alpha16
# MIRROR_AI_RENDER_TIMEOUT_MS=1800000

# -----------------------------------------------------------------------------
# Optional — XCTest screenshot rendering (macOS + Xcode only)
# -----------------------------------------------------------------------------
# MIRROR_AI_IOS_SIMULATOR=iPhone 16
# MIRROR_AI_IOS_SCHEME=
# MIRROR_AI_IOS_CONFIGURATION=Dev
# MIRROR_AI_MAX_IOS_FRAMES=12
